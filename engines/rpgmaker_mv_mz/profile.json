{
  "_doc": "RPG Maker MV/MZ（www/data 或 data 下的 JSON）。contexts 取自 vendor/export_script.py CONTEXT_TYPES，優先級與預設跳過取自 GalTransl/text/translate_rpgmaker.py:56-85（使用者慣用 --priority 7 只翻到 actor）。",
  "schema_version": 1,
  "name": "rpgmaker_mv_mz",
  "display_name": "RPG Maker MV / MZ",
  "aliases": [
    "rpgmaker",
    "rpgmaker_mv",
    "rpgmaker_mz",
    "mv",
    "mz",
    "rmmv",
    "rmmz"
  ],
  "variants": {
    "MV": {
      "source_encoding": "utf-8",
      "target_encoding": "utf-8",
      "data_dir": "www/data",
      "core_js": "js/rpg_core.js"
    },
    "MZ": {
      "source_encoding": "utf-8",
      "target_encoding": "utf-8",
      "data_dir": "data",
      "core_js": "js/rmmz_core.js"
    }
  },
  "detection": {
    "files_any": [
      "www/data/System.json",
      "data/System.json"
    ],
    "evidence_files": {
      "www/js/rpg_core.js": "MV",
      "js/rpg_core.js": "MV",
      "js/rmmz_core.js": "MZ",
      "www/index.html": "MV",
      "package.json": ""
    },
    "negative_files": [
      "Data.wolf",
      "Game.rgss3a"
    ]
  },
