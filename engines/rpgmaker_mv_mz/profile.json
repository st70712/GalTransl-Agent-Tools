  "control_codes": {
    "_doc": "RPG Maker 控制碼不分大小寫（\\N[1] 與 \\n[1] 相同）。value 取自 export_script.py CONTROL_CODES 與 memory「翻譯器會破壞控制碼」；leading 只摘純表現碼，\\N[1] 是句子主詞不能摘。",
    "case_insensitive": true,
    "value_codes": "\\\\(?:N\\[\\d+\\]|P\\[\\d+\\]|V\\[\\d+\\]|G|I\\[\\d+\\])",
    "style_codes": "\\\\(?:C\\[\\d+\\]|FS\\[\\d+\\]|PX\\[\\d+\\]|PY\\[\\d+\\]|\\{|\\}|\\$|\\.|\\||!|>|<|\\^)",
    "leading_codes": "^(?:\\\\(?:C\\[\\d+\\]|FS\\[\\d+\\]|PX\\[\\d+\\]|PY\\[\\d+\\]|\\{|\\}|\\$|\\.|\\||!|>|<|\\^))+",
    "stray_escape": "\\\\[a-zA-Z]"
  },
  "placeholders": [
    "%\\d"
  ],
  "_placeholders_doc": "terms.messages 的 %1 %2 是執行期替換的佔位符，遺失視同帶值控制碼遺失。",
  "symbol_map": {},
  "literal_newline_policy": "revert",
  "line_count_policy": "warn",
  "japanese_detection": "kana_or_kanji",
  "never_export": [
    "402（選項分支標頭）、108/408（註解）、355/655（腳本）、320/324（改名）不抽取",
    "沒有前導 101 的裸 401 不抽取（vendor 已知限制）",
    "圖片檔名（231）只在含日文時導出為 picture_name，翻了必須同時改圖片檔名",
    "開關／變數名稱（debug_name）玩家看不到"
  ],
  "patch": {
    "steps": [
      "copy_changed_json",
      "write_install_notes"
    ],
    "_font_doc": "MV: fonts/gamefont.css 指定字型；MZ: System.json advanced.mainFontFilename。缺字要先量測再決定要不要換。",
    "deliverables": {
      "MV": [
        "www/data/*.json"
      ],
      "MZ": [
        "data/*.json"
      ]
    }
  },
  "acceptance_checklist": [
    "遊戲開得起來，沒有 Loading Error（圖片檔名沒被污染）",
    "對話、選項顯示中文，多行對話沒被截斷",
    "\\N[n]／\\V[n] 顯示的是角色名／數值而不是字面碼",
    "選單指令、道具／技能名稱與說明",
    "字型有沒有缺字"
  ],
  "docs": [
    "engines/rpgmaker_mv_mz/vendor/README.md",
    "engines/rpgmaker_mv_mz/NOTES.md"
  ]
}
